# Copy this file to .env before running Docker Compose.
APP_PORT=8080
TRAVELMIND_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Keep AI_PROVIDER=ollama and start the optional local-ai Compose profile,
# or set AI_PROVIDER=openai and provide your own API key.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=180
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
